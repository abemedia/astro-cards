---
import { Font } from 'astro:assets'

interface Props {
  title?: string
}

const { title = 'plain' } = Astro.props
---

<Font cssVariable="--font-test" />
<div class="card">{title}</div>

<style is:inline>
.card {
  width: 100%;
  height: 100%;
  background: #226644;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-test);
  font-size: 40px;
}
</style>
