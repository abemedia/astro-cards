---
import roboto400 from '@fontsource/roboto/400.css?inline'
import roboto700 from '@fontsource/roboto/700.css?inline'

interface Props {
  title?: string
  tone?: string
}

export const card = { width: 400, height: 200 }

const { title = 'untitled', tone = '#d98e4a' } = Astro.props
---

<style set:html={roboto400 + roboto700}></style>
<div class="card" style={`background:${tone}`}>
  <div class="title">{title}</div>
  <div class="scripts">Ag Бв Δξ</div>
</div>

<style is:inline>
.card {
  width: 400px;
  height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: Roboto, sans-serif;
  color: #ffffff;
}
.title {
  font-size: 32px;
  font-weight: 700;
}
.scripts {
  font-size: 24px;
  font-weight: 400;
  margin-top: 8px;
}
</style>
