---
import { Font } from 'astro:assets'

export const card = { format: 'png' }
---

<Font cssVariable="--font-test" />
<div class="card">png</div>

<style is:inline>
.card {
  width: 100%;
  height: 100%;
  background: #884422;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-test);
  font-size: 40px;
}
</style>
